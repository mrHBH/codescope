{
  "name": "codescope",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "upstream:sync": "git -C ../windfoil fetch origin && git -C ../windfoil reset --hard origin/main",
