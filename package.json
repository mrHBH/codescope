  },
  "dependencies": {
    "camera-controls": "^3.1.2",
    "opentype.js": "^2.0.0",
    "png-tools": "^1.0.4",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/three": "^0.185.0",
    "@webgpu/types": "^0.1.71",
    "typescript": "^7.0.2",
    "vite": "^8.1.3"
  }
}
